---
const benefits = [
  "Lock in the founder’s rate — $69/mo",
  "Branded client app, CRM & investor tools in one",
  "No contracts — cancel anytime",
  "We’ll personally get you set up",
];
---

<section id="join" class="py-16 md:py-24 bg-brand-dark-green relative overflow-hidden scroll-mt-20">
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-green/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Left: copy + benefits -->
      <div>
        <p class="text-brand-orange font-semibold mb-3 text-sm uppercase tracking-wide">
          Get Early Access
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
          Join the Waitlist
        </h2>
        <p class="text-lg text-brand-light-green max-w-xl">
          Lock in the founder’s rate and be first in line. We’ll reach out
          personally to get you set up.
        </p>

        <ul class="mt-8 space-y-4">
          {
            benefits.map((b) => (
              <li class="flex items-start gap-3 text-white">
                <span class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-brand-orange/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: form (transparent — dark section shows through) -->
      <div>
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/ss6uUK9BuwAAvyZUHAsd"
          style="width:100%;height:100%;border:none;border-radius:8px;background:transparent"
          id="inline-ss6uUK9BuwAAvyZUHAsd"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Waitlist"
          data-height="611"
          data-layout-iframe-id="inline-ss6uUK9BuwAAvyZUHAsd"
          data-form-id="ss6uUK9BuwAAvyZUHAsd"
          title="Waitlist"></iframe>

        <p class="mt-4 text-xs text-brand-light-green/80 leading-relaxed">
          By submitting this form, you agree to receive text messages from Brick
          and Yield LLC regarding our platform and real estate technology
          services. Message frequency varies. Message and data rates may apply.
          Reply STOP to opt out at any time. Reply HELP for help. See our
          <a href="/terms" class="underline hover:text-brand-orange">Terms of Service</a>
          and
          <a href="/privacy" class="underline hover:text-brand-orange">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </div>

  <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
</section>
