---
import SectionHeading from "./SectionHeading.astro";

const features = [
  "Branded client app (iOS)",
  "Full client pipeline with stages",
  "Transaction management & deadline tracking",
  "Commission calculator",
  "40+ MLS search filters incl. investment analysis",
  "Calendar with Google Calendar sync",
  "In-app messaging (general + property-specific)",
  "Buyer & seller portals",
  "Household & co-buyer support",
  "Zapier integration",
  "Push notifications",
  "Learn tab for client education",
];
---

<section id="pricing" class="py-16 md:py-24 bg-brand-dark-green relative overflow-hidden">
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-green/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      light
      eyebrow="Simple Pricing"
      title="Lock In the Founder’s Rate"
      subtitle="One plan, everything included. No contracts, cancel anytime."
    />

    <div class="max-w-lg mx-auto">
      <div class="bg-white rounded-3xl p-8 md:p-10 shadow-xl border-2 border-brand-orange relative">
        <div class="absolute -top-3.5 left-8">
          <span class="bg-brand-orange text-white text-xs font-semibold px-4 py-1.5 rounded-full">
            Limited Availability
          </span>
        </div>
        <div class="mt-4">
          <h3 class="text-2xl font-bold text-gray-900">Founder’s Rate</h3>
          <div class="mt-4 flex items-baseline gap-3">
            <span class="text-2xl text-gray-400 line-through">$99</span>
            <span class="text-5xl font-bold text-gray-900">$69</span>
            <span class="text-gray-500">/mo</span>
          </div>
          <p class="mt-4 text-gray-600 leading-relaxed">
            Lock in the early adopter rate — goes to $99/mo after founder slots
            fill up. No contracts, cancel anytime.
          </p>
          <ul class="mt-6 space-y-3">
            {
              features.map((item) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <svg class="w-5 h-5 text-brand-dark-green mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
          <a
            href="#join"
            class="mt-8 block w-full text-center rounded-lg bg-brand-dark-green px-6 py-4 font-semibold text-white transition-colors hover:bg-brand-green"
          >
            Join the Waitlist
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
