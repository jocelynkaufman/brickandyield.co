---
import SectionHeading from "./SectionHeading.astro";
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Live and Expanding Fast"
      title="Live MLS Coverage"
      subtitle="Currently powering the Wasatch Front — with more markets on the way."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <!-- Active MLS -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700 mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Live
        </span>
        <h3 class="text-lg font-bold text-gray-900 mb-1">Wasatch Front Regional MLS</h3>
        <p class="text-gray-500 text-sm">WFRMLS — Utah</p>
      </div>

      <!-- Coming Soon -->
      <div class="bg-gray-50 rounded-2xl p-8 shadow-sm border border-gray-100">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-orange/20 px-3 py-1 text-xs font-semibold text-brand-dark-orange mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-orange"></span>
          Coming Soon
        </span>
        <h3 class="text-lg font-bold text-gray-400 mb-1">More Markets</h3>
        <p class="text-gray-400 text-sm">Additional MLS regions in the works</p>
      </div>

      <!-- Request -->
      <div class="bg-gray-50 rounded-2xl p-8 shadow-sm border border-dashed border-gray-300 flex flex-col justify-center">
        <h3 class="text-lg font-bold text-gray-700 mb-2">Don’t see your MLS?</h3>
        <p class="text-gray-500 text-sm mb-4">
          Join the waitlist and let us know which market you’re in.
        </p>
        <a
          href="#join"
          class="inline-block text-center rounded-lg bg-brand-dark-green px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-green transition-colors"
        >
          Request Your MLS
        </a>
      </div>
    </div>
  </div>
</section>
