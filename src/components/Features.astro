---
import SectionHeading from "./SectionHeading.astro";

const features = [
  {
    title: "Your Brand, Not Zillow’s",
    description:
      "Your clients aren’t using your IDX site — they’re on Zillow. Replace outdated email alerts and clunky search pages with a branded mobile app they actually open. Your name, your brokerage, your app on their phone.",
    icon: `<rect x="10" y="4" width="20" height="32" rx="4" stroke="currentColor" stroke-width="2"/><path d="M17 8h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="20" cy="30" r="2" stroke="currentColor" stroke-width="2"/>`,
  },
  {
    title: "Curated, Not Searched",
    description:
      "You’re not giving clients a search bar. You’re curating properties for them with context only an agent can provide. That’s what makes you irreplaceable.",
    icon: `<rect x="4" y="8" width="32" height="24" rx="3" stroke="currentColor" stroke-width="2"/><path d="M4 14h32" stroke="currentColor" stroke-width="2"/><circle cx="28" cy="24" r="4" stroke="currentColor" stroke-width="2"/><path d="M31 27l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    title: "Investor & House Hack Analysis",
    description:
      "Every listing shows cash flow projections, cap rates, and house hack scenarios. Give your investor clients instant answers without spreadsheets.",
    icon: `<rect x="6" y="4" width="28" height="32" rx="3" stroke="currentColor" stroke-width="2"/><path d="M12 16h16M12 22h10M12 28h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 10h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    title: "Buyer & Seller Portals",
    description:
      "Buyers and sellers each get their own portal. Present offers, send showing feedback, track transactions. Co-buyers and co-sellers get separate logins with shared access. Onboard sellers at the consultation and capture the lead from day one.",
    icon: `<rect x="4" y="6" width="14" height="28" rx="3" stroke="currentColor" stroke-width="2"/><rect x="22" y="6" width="14" height="28" rx="3" stroke="currentColor" stroke-width="2"/><path d="M8 12h6M24 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M8 18h6M24 18h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    title: "Built for Agents and Brokers",
    description:
      "Whether you’re an independent agent or running a brokerage, Brick & Yield scales with you. Broker dashboard gives you oversight of every agent’s pipeline without adding busywork.",
    icon: `<circle cx="20" cy="12" r="5" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="28" r="4" stroke="currentColor" stroke-width="2"/><circle cx="30" cy="28" r="4" stroke="currentColor" stroke-width="2"/><path d="M20 17v5M15 25l-2-1M25 25l2-1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    title: "Learn Tab",
    description:
      "Curate custom educational content for your clients so you don’t answer the same questions over and over. Such as First-time buyer guides, investment basics, market updates — all branded to you.",
    icon: `<path d="M6 8h12v24H6zM22 8h12v24H22z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M18 8v24" stroke="currentColor" stroke-width="2"/><path d="M10 14h4M10 20h4M26 14h4M26 20h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
];
---

<section id="features" class="py-16 md:py-24 bg-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="What You Get"
      title="CRM + IDX in One Platform"
      subtitle="Built by an agent, for solo agents and broker teams alike. Make yourself irreplaceable."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        features.map((feature) => (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 transition-shadow hover:shadow-lg">
            <div class="w-14 h-14 rounded-xl bg-brand-light-green/40 flex items-center justify-center text-brand-dark-green mb-5">
              <svg viewBox="0 0 40 40" fill="none" class="w-8 h-8" set:html={feature.icon} />
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{feature.title}</h3>
            <p class="text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
