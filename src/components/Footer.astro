---
const year = new Date().getFullYear();

const product = [
  { label: "Features", href: "/#features" },
  { label: "How It Works", href: "/#how-it-works" },
  { label: "Pricing", href: "/#pricing" },
  { label: "FAQ", href: "/#faq" },
];

const company = [
  { label: "Blog", href: "/blog" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
];

const socials = [
  {
    label: "Instagram",
    href: "#",
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  },
  {
    label: "Facebook",
    href: "#",
    path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  },
  {
    label: "LinkedIn",
    href: "#",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];
---

<footer class="relative overflow-hidden bg-brand-dark-green text-white">
  <!-- Mountain texture -->
  <svg
    class="absolute pointer-events-none"
    style="bottom:0;left:0;right:0;width:100%;height:230px;z-index:0"
    viewBox="0 0 1200 100"
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
  >
    <path
      d="M0,100 C0,70 80,60 160,55 C240,45 320,55 400,48 C480,40 560,52 640,45 C720,40 800,50 880,42 C960,38 1040,48 1120,43 L1200,45 L1200,100 Z"
      fill="#ffffff"
      opacity="0.05"></path>
    <path
      d="M0,100 L0,50 L80,20 L160,40 L240,15 L320,35 L400,10 L480,30 L560,5 L640,25 L720,15 L800,40 L880,18 L960,38 L1040,12 L1120,32 L1200,20 L1200,100 Z"
      fill="#ffffff"
      opacity="0.085"></path>
  </svg>

  <div
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 sm:gap-12 mb-8 sm:mb-12"
    >
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/favicon.png"
            width="48"
            height="48"
            alt="Brick & Yield logo"
            class="h-12 w-12 rounded-lg"
          />
          <div class="flex flex-col leading-none">
            <h3 class="text-2xl font-bold">Brick &amp; Yield</h3>
            <span class="text-xs font-medium text-brand-light-green/70 mt-1">
              Powered by StoddGroup
            </span>
          </div>
        </div>
        <p class="text-brand-light-green mb-6 max-w-md">
          Real estate technology for agents who give a damn. A branded client
          portal that keeps you at the center of every client relationship.
        </p>
        <div class="flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="w-9 h-9 rounded-full bg-white/10 text-brand-light-green flex items-center justify-center hover:text-brand-orange hover:bg-white/20 transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Product -->
      <div>
        <h4 class="font-bold mb-4 text-brand-orange">Product</h4>
        <ul class="space-y-3">
          {
            product.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-brand-light-green hover:text-white transition-colors"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-bold mb-4 text-brand-orange">Company</h4>
        <ul class="space-y-3">
          {
            company.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-brand-light-green hover:text-white transition-colors"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-bold mb-4 text-brand-orange">Contact</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="mailto:jocelyn@brickandyield.co"
              class="text-brand-light-green hover:text-white transition-colors break-words"
            >
              jocelyn@brickandyield.co
            </a>
          </li>
          <li>
            <a
              href="tel:+18014412557"
              class="text-brand-light-green hover:text-white transition-colors"
            >
              (801) 441-2557
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-brand-green/30 pt-8 text-center">
      <p class="text-brand-light-green text-sm">
        &copy; {year} Brick and Yield LLC. All rights reserved.
        <span style="margin:0 0.4rem;opacity:0.5">&middot;</span>
        <a href="/privacy" class="text-brand-light-green hover:text-white transition-colors">Privacy Policy</a>
        <span style="margin:0 0.4rem;opacity:0.5">&middot;</span>
        <a href="/terms" class="text-brand-light-green hover:text-white transition-colors">Terms of Service</a>
      </p>
      <p
        class="text-brand-light-green text-sm"
        style="margin-top:1rem;max-width:52rem;margin-left:auto;margin-right:auto;line-height:1.6"
      >
        Currently serving the Wasatch Front Regional MLS (Utah). Brick &amp;
        Yield is a real estate technology platform for licensed agents and
        brokers.
      </p>
    </div>
  </div>
</footer>
