---
import { Image } from "astro:assets";
import heroBg from "../assets/hero-home-dusk.jpg";
import heroApp from "../assets/hero-app.jpeg";
---

<section
  class="relative pt-12 md:pt-20 pb-16 md:pb-24 overflow-hidden bg-brand-deep"
>
  <!-- Background photo + dark teal overlay -->
  <div class="absolute inset-0 pointer-events-none">
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0" style="background:rgba(27,50,52,0.88)"></div>
  </div>

  <!-- Decorative glows -->
  <div
    class="absolute -top-32 -right-24 w-[28rem] h-[28rem] bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute -bottom-40 -left-32 w-[28rem] h-[28rem] bg-brand-green/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: copy -->
      <div class="max-w-xl">
        <!-- Eyebrow chip -->
        <div
          class="inline-flex items-center gap-2.5 bg-brand-orange/15 border border-brand-orange/40 text-[#f4c89d] px-4 py-2 rounded-full text-sm font-semibold mb-6"
        >
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l2.39 7.36H22l-6.18 4.49L18.18 21 12 16.5 5.82 21l2.36-7.15L2 9.36h7.61z"></path>
          </svg>
          The agent-branded client portal
        </div>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight"
        >
          Your Clients Deserve <span style="color:#bad9d9">Better</span> Than Email Alerts
        </h1>
        <p class="text-lg md:text-xl mb-8 leading-relaxed text-white/90">
          Brick &amp; Yield gives agents a branded client portal with curated
          property searches, investor analysis, and a native mobile app — so
          your clients stay with you, not Zillow.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#join"
            class="inline-flex items-center justify-center gap-2 bg-brand-orange text-brand-deep px-8 py-4 rounded-lg font-bold text-lg shadow-lg shadow-brand-orange/25 hover:bg-brand-dark-orange transition-colors"
          >
            Join the Waitlist
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold text-lg border border-white/25 text-white hover:bg-white/10 transition-colors"
          >
            See How It Works
          </a>
        </div>

        <!-- Trust strip -->
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-white/70">
          <span class="inline-flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            Live on the Wasatch Front MLS
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-brand-orange"></span>
            Built by a Utah agent
          </span>
        </div>
      </div>

      <!-- Right: phone showcase -->
      <div class="relative">
        <div
          class="relative mx-auto max-w-xs sm:max-w-sm rounded-[2.5rem] border-[10px] border-black bg-black shadow-2xl overflow-hidden aspect-[9/19]"
        >
          <Image
            src={heroApp}
            alt="Brick & Yield client app — curated listings with cap rate and cash flow analysis"
            class="w-full h-full object-cover"
            widths={[390, 600]}
            sizes="(max-width: 640px) 80vw, 390px"
            loading="eager"
          />
        </div>
        <div
          class="absolute -bottom-6 -right-2 sm:right-6 w-44 bg-white rounded-2xl shadow-xl border border-gray-100 p-4 hidden sm:block"
        >
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">
            Cash Flow
          </p>
          <p class="text-2xl font-bold text-brand-dark-green">+$420<span class="text-sm font-medium text-gray-400">/mo</span></p>
          <p class="text-xs text-gray-500 mt-1">Cap rate 6.8% · auto-calculated</p>
        </div>
      </div>
    </div>
  </div>
</section>
