---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const DEFAULT_TITLE =
  "Brick & Yield — Agent-Branded Client Portal for Real Estate";
const DEFAULT_DESCRIPTION =
  "Branded mobile app and CRM for real estate agents — client pipeline, transaction management, investment analysis, and in-app messaging. Replace your IDX site, CRM, and spreadsheets.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  ogType = "website",
  publishedTime,
  modifiedTime,
  jsonLd,
  ogImage = "/og-image.png",
} = Astro.props;

const fullTitle = title ? `${title} — Brick & Yield` : DEFAULT_TITLE;
const canonicalURL =
  canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Brick and Yield LLC",
  url: "https://brickandyield.co",
  description: "White-labeled real estate client portal for agents and brokers",
  email: "jocelyn@brickandyield.co",
  areaServed: "Utah",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Fonts: DM Sans (headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Brick & Yield" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title ?? DEFAULT_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgJsonLd)}
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white pt-16">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Analytics & widgets -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-YGDF6446FR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-YGDF6446FR");
    </script>
    <script
      is:inline
      src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="69ced920fb68eb1e458e69cd"></script>
    <script
      is:inline
      src="https://go.brickandyield.co/js/external-tracking.js"
      data-tracking-id="tk_e7ac32290bc7481b924fc3855c816958"></script>
  </body>
</html>
