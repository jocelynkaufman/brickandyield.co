---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getSortedPosts } from "@/content/posts";
import { getCover } from "../../lib/blogCovers";

const posts = getSortedPosts();

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title="Blog"
  description="Insights on real estate technology, client experience, and growing your business with Brick & Yield."
  canonical="https://brickandyield.co/blog"
>
  <!-- Dark header -->
  <section class="relative overflow-hidden bg-brand-deep pt-12 md:pt-16 pb-12 md:pb-16">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-brand-orange font-semibold mb-3 text-sm uppercase tracking-wide">
        The Brick &amp; Yield Blog
      </p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Blog</h1>
      <p class="text-lg text-brand-light-green max-w-2xl">
        Insights on real estate technology, client experience, and growing your
        business.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          posts.map((post) => {
            const cover = getCover(post.slug);
            return (
              <a
                href={`/blog/${post.slug}`}
                class="group flex flex-col rounded-2xl bg-white border border-gray-100 shadow-sm overflow-hidden transition-shadow hover:shadow-lg"
              >
                {cover && (
                  <div class="overflow-hidden">
                    <Image
                      src={cover}
                      alt={post.title}
                      widths={[400, 800]}
                      sizes="(max-width: 768px) 100vw, 50vw"
                      class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6 flex flex-col flex-1">
                  <p class="text-xs font-semibold text-brand-dark-orange mb-2">
                    {fmt(post.publishedAt)}
                  </p>
                  <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-dark-green transition-colors mb-3 line-clamp-2">
                    {post.title}
                  </h2>
                  <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
                    {post.description}
                  </p>
                  {post.tags && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {post.tags.map((tag) => (
                        <span class="text-xs bg-brand-light-green/40 text-brand-dark-green rounded-full px-3 py-1">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            );
          })
        }
      </div>

      {
        posts.length === 0 && (
          <p class="text-gray-500 text-center py-20">
            No posts yet. Check back soon!
          </p>
        )
      }

      <!-- Pagination -->
      <div
        id="blog-pagination"
        style="display:none;justify-content:center;align-items:center;gap:0.5rem;margin-top:3rem;flex-wrap:wrap"
      >
        <button
          class="pagination-btn pagination-prev"
          data-nav="prev"
          style="padding:0.625rem 1.125rem;border-radius:9999px;font-size:0.875rem;font-weight:600;cursor:pointer;border:2px solid #395659;background:white;color:#395659;transition:all 0.2s"
          >&larr; Prev</button
        >
        <div
          id="pagination-numbers"
          style="display:flex;gap:0.25rem;flex-wrap:wrap;justify-content:center"
        >
        </div>
        <button
          class="pagination-btn pagination-next"
          data-nav="next"
          style="padding:0.625rem 1.125rem;border-radius:9999px;font-size:0.875rem;font-weight:600;cursor:pointer;border:2px solid #395659;background:white;color:#395659;transition:all 0.2s"
          >Next &rarr;</button
        >
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const PER_PAGE = 12;
      const grid = document.getElementById("blog-grid");
      const pagination = document.getElementById("blog-pagination");
      if (!grid || !pagination) return;
      const cards = [...grid.children];
      const numsEl = document.getElementById("pagination-numbers");
      const prevBtn = pagination.querySelector(".pagination-prev");
      const nextBtn = pagination.querySelector(".pagination-next");
      const totalPages = Math.max(1, Math.ceil(cards.length / PER_PAGE));
      let page = 1;

      function render() {
        const start = (page - 1) * PER_PAGE;
        cards.forEach((c, i) => {
          c.style.display = i >= start && i < start + PER_PAGE ? "" : "none";
        });

        numsEl.innerHTML = "";
        if (totalPages <= 1) {
          pagination.style.display = "none";
          return;
        }
        pagination.style.display = "flex";

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement("button");
          btn.textContent = i;
          const active = i === page;
          btn.style.cssText =
            "padding:0.625rem 1rem;min-width:2.75rem;border-radius:9999px;font-size:0.875rem;font-weight:600;cursor:pointer;border:2px solid #395659;transition:all 0.2s;background:" +
            (active ? "#395659" : "white") +
            ";color:" +
            (active ? "white" : "#395659");
          btn.addEventListener("click", () => goto(i));
          btn.addEventListener("mouseenter", () => {
            if (i !== page) btn.style.background = "rgba(186,217,217,0.3)";
          });
          btn.addEventListener("mouseleave", () => {
            if (i !== page) btn.style.background = "white";
          });
          numsEl.appendChild(btn);
        }

        prevBtn.disabled = page === 1;
        nextBtn.disabled = page === totalPages;
        [prevBtn, nextBtn].forEach((b) => {
          b.style.opacity = b.disabled ? "0.4" : "1";
          b.style.cursor = b.disabled ? "not-allowed" : "pointer";
        });
      }

      function goto(p) {
        page = p;
        render();
        const top = grid.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top, behavior: "smooth" });
      }

      prevBtn.addEventListener("click", () => {
        if (page > 1) goto(page - 1);
      });
      nextBtn.addEventListener("click", () => {
        if (page < totalPages) goto(page + 1);
      });
      [prevBtn, nextBtn].forEach((b) => {
        b.addEventListener("mouseenter", () => {
          if (!b.disabled) b.style.background = "rgba(186,217,217,0.3)";
        });
        b.addEventListener("mouseleave", () => {
          if (!b.disabled) b.style.background = "white";
        });
      });

      render();
    })();
  </script>
</Base>
